# Local-only tfvars for `terraform` CLI use. In CI these come from TF Cloud workspace variables.
# Copy to terraform.tfvars (gitignored) and fill in.

# domain                = "vicio.ovh"
# cloudflare_zone_id    = "your-zone-id"
# cluster_subdomain     = "k8s"
# cluster_name          = "k8s-hetzner"
# network_region        = "eu-central"
# management_cidrs      = ["185.14.151.136/32"]

# Sensitive — pass via env vars instead:
#   HCLOUD_TOKEN=...
#   CLOUDFLARE_API_TOKEN=...
#   TF_VAR_ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
#   TF_VAR_ssh_private_key="$(cat ~/.ssh/id_ed25519)"
